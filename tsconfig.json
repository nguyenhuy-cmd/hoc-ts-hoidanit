{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",// Để hỗ trọ tốt cho phía browser (trình duyệt web)
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,// không cho phép TypeScript tự ý (ngầm hiểu) gán kiểu any
    "strictNullChecks": true// Khi 1 giá trị là null/undefine, bạn cần kiểm tra giá trị trc khi sử dụng

  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
